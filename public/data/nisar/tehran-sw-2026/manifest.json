 "caveats": [
  {
   "id": "relative",
   "text": "Rates are relative to the median of the whole area, not absolute. A stable benchmark (GNSS) would be needed to fix the zero.",
   "source": "method"
  },
  {
   "id": "short_record",
   "text": "Built from 4 months of data (2026-06-18 to 2026-10-21). The yearly rate is a straight-line extrapolation and may include seasonal motion.",
   "source": "method"
  },
  {
   "id": "uncertainty",
   "text": "A typical 80 m pixel is uncertain by about ±100 mm/yr (one standard error, median over the area), mostly from atmospheric delay. Read patterns several kilometres wide, not single pixels.",
   "source": "method"
  },
  {
   "id": "vertical_assumption",
   "text": "Vertical motion is computed from two viewing directions assuming no north-south ground motion.",
   "source": "method"
  },
  {
   "id": "no_data",
   "text": "Transparent areas were not measured (water, vegetation change, steep terrain or low coherence). Not measured does not mean not moving.",
   "source": "method"
  },
  {
   "id": "provisional",
   "text": "NISAR products in this bundle are PROVISIONAL releases; calibration and processing may change in later versions.",
   "source": "method"
  },
  {
   "id": "both_directions",
   "text": "The south-west sinking bowl appears independently in the ascending and descending passes (their rates correlate at 0.66), so it is not an artefact of one viewing geometry.",
   "source": "analyst"
  },
  {
   "id": "foothill_uplift",
   "text": "Apparent uplift along the northern Alborz foothills is most likely an elevation-dependent atmospheric artefact, not real uplift.",
   "source": "analyst"
  },
  {
   "id": "stripes",
   "text": "Faint diagonal stripes along radar swath edges are processing artefacts.",
   "source": "analyst"
  },
  {
   "id": "descending_noise",
   "text": "The descending passes are about twice as noisy as the ascending ones; the product troposphere correction made them worse, so it was applied to the ascending passes only.",
   "source": "analyst"
  },
  {
   "id": "tilt_not_damage",
   "text": "Building ratings describe ground tilt beneath each footprint from 80 m radar pixels. They are not an assessment of any building.",
   "source": "method"
  },
  {
   "id": "osm_partial",
   "text": "OpenStreetMap does not map every building. Missing buildings are unmapped, not unaffected.",
   "source": "method"
  },
  {
   "id": "heights",
   "text": "Most buildings have no height in OpenStreetMap and use a flagged estimate.",
   "source": "method"
  }
