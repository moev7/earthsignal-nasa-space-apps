# Substitute nasa.r8volt.com if deploying another hostname; obtain TLS first.
server {
    listen 80;
    listen [::]:80;
    server_name nasa.r8volt.com;
    location /.well-known/acme-challenge/ { root /var/lib/earthsignal-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name nasa.r8volt.com;
    ssl_certificate /etc/letsencrypt/live/nasa.r8volt.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nasa.r8volt.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;
    client_body_timeout 10s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location = /health { proxy_pass http://127.0.0.1:8030/health; }
    location / {
        proxy_pass http://127.0.0.1:3040;
        proxy_http_version 1.1;
        proxy_set_header Host nasa.r8volt.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host nasa.r8volt.com;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 35s;
        proxy_buffering off;
    }
}
