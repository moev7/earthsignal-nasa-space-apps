# Install at /etc/earthsignal/service.env, root:earthsignal, mode 0640.
# Coordinator provisions the same random >=32-byte key to gateway and service.
EARTHSIGNAL_GATEWAY_SECRET=REPLACE_WITH_RANDOM_SHARED_SECRET
EARTHSIGNAL_DATA_DIR=/var/lib/earthsignal
EARTHSIGNAL_NETRC=/etc/earthsignal/earthdata.netrc
# Optional bounded overrides (defaults shown); never exceed approved hard caps.
EARTHSIGNAL_MAX_PIXELS=1000000
EARTHSIGNAL_QUEUE_LIMIT=8
EARTHSIGNAL_OWNER_OUTSTANDING=2
EARTHSIGNAL_OWNER_DAILY=5
EARTHSIGNAL_WALL_SECONDS=1200
EARTHSIGNAL_TRANSFER_BYTES=536870912
EARTHSIGNAL_STORAGE_BYTES=1073741824
EARTHSIGNAL_RESERVE_BYTES=3221225472
EARTHSIGNAL_EXPIRY_SECONDS=604800
EARTHSIGNAL_LEASE_SECONDS=60

# Independent incremental activation; omit a domain to stop new submissions.
EARTHSIGNAL_ASSESSMENT_DOMAINS=water,fire,ecology,urban
EARTHSIGNAL_SCENARIOS_ENABLED=true

# Enable only after explicit operator acceptance of the RCM Public User License.
# This is an access gate, not a click-through license proxy.
EARTHSIGNAL_RCM_ACCESS_APPROVED=false
