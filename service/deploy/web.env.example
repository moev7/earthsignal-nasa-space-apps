# /etc/earthsignal/web.env root:earthsignal-web 0640; never commit real values.
EARTHSIGNAL_PUBLIC_ORIGIN=https://nasa.r8volt.com
EARTHSIGNAL_PROCESSING_URL=http://127.0.0.1:8030
EARTHSIGNAL_GATEWAY_SECRET=REPLACE_WITH_SAME_RANDOM_SERVICE_SECRET
EARTHSIGNAL_AUTH_DB=/var/lib/earthsignal-web/auth.sqlite3

# Optional Gemini public science assistant; never send private assessment records.
EARTHSIGNAL_GEMINI_API_KEY=REPLACE_SERVER_SIDE_ONLY
EARTHSIGNAL_GEMINI_FREE_TIER=false
EARTHSIGNAL_ASSISTANT_DB=/var/lib/earthsignal-web/assistant.sqlite3
