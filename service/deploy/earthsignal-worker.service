[Unit]
Description=Earthsignal single bounded radar worker
After=network-online.target
Wants=network-online.target

[Service]
User=earthsignal
Group=earthsignal
Slice=earthsignal.slice
WorkingDirectory=/opt/earthsignal
EnvironmentFile=/etc/earthsignal/service.env
Environment=PYTHONUNBUFFERED=1 GDAL_CACHEMAX=32 GDAL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ExecStart=/opt/earthsignal/service/.venv/bin/python -m service.worker
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/earthsignal
LimitNOFILE=128
LimitFSIZE=1073741824

[Install]
WantedBy=multi-user.target
