# Earthsignal Environment Configuration Example
# Inject into the shell or systemd service environment. Production standalone does not auto-load this file.
# Never commit active secrets, credentials, or production connection strings.

# ==============================================================================
# Frontend Web Service Configuration (Node vinext standalone)
# ==============================================================================

# Public HTTPS origin of the application. Used for exact-origin CSRF verification
# and Secure cookie attributes. Must match the public browser-facing URL.
EARTHSIGNAL_PUBLIC_ORIGIN=https://nasa.r8volt.com

# Backend science service URL. Must point to the internal loopback endpoint.
EARTHSIGNAL_PROCESSING_URL=http://127.0.0.1:8030

# Shared HMAC gateway secret. Minimum 32 characters/bytes.
# Shared strictly between the frontend gateway adapter and backend science service.
EARTHSIGNAL_GATEWAY_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG

# SQLite database path for local collaborator authentication and session storage.
# Directory must exist and be owned by the frontend user (mode 0700).
EARTHSIGNAL_AUTH_DB=/var/lib/earthsignal-web/auth.sqlite3

# Frontend service listening port (default in systemd is 3040)
HOST=127.0.0.1
PORT=3040
NODE_ENV=production

# ==============================================================================
# Science Processing Service Configuration (FastAPI / uvicorn / Worker)
# ==============================================================================

# Root directory for worker staging, results, and SQLite jobs database.
# Must be owned by the backend service user with mode 0700.
EARTHSIGNAL_DATA_DIR=/var/lib/earthsignal

# Path to the Earthdata netrc credentials file on the server.
# File permissions must be 0600, owned by the backend service user.
EARTHSIGNAL_NETRC=/etc/earthsignal/earthdata.netrc

# Bounded operational limits (defaults shown; bounded by service validation)
# Maximum native pixels allowed per crop request (1 to 1,000,000)
EARTHSIGNAL_MAX_PIXELS=1000000

# Maximum queued jobs waiting for worker claim (1 to 8)
EARTHSIGNAL_QUEUE_LIMIT=8

# Maximum concurrent queued/running jobs per owner (1 to 2)
EARTHSIGNAL_OWNER_OUTSTANDING=2

# Maximum job submissions per owner in rolling 24 hours (1 to 5)
EARTHSIGNAL_OWNER_DAILY=5

# Maximum monotonic processing wall-clock limit in seconds (1 to 1200)
EARTHSIGNAL_WALL_SECONDS=1200

# Maximum cumulative HTTP range transfer limit in bytes (1 to 536,870,912 = 512 MiB)
EARTHSIGNAL_TRANSFER_BYTES=536870912

# Maximum total results and staging storage ceiling in bytes (up to 1 GiB)
EARTHSIGNAL_STORAGE_BYTES=1073741824

# Minimum disk reserve in bytes required on the storage filesystem (3 GiB)
EARTHSIGNAL_RESERVE_BYTES=3221225472

# Expiry duration in seconds for completed/failed unpinned jobs (7 days)
EARTHSIGNAL_EXPIRY_SECONDS=604800

# Worker job lease heartbeat interval in seconds (5 to 60)
EARTHSIGNAL_LEASE_SECONDS=60

# Independent observatory activation (production defaults off when omitted).
EARTHSIGNAL_ASSESSMENT_DOMAINS=water,fire,ecology,urban
EARTHSIGNAL_SCENARIOS_ENABLED=true
# Experimental, owner-only sampling jobs; service-side activation is separate.
EARTHSIGNAL_AREA_EXPERIMENTS_ENABLED=false
# Optional public-evidence Gemini; separate server-only free-tier connection.
EARTHSIGNAL_GEMINI_API_KEY=REPLACE_SERVER_SIDE_ONLY
EARTHSIGNAL_GEMINI_FREE_TIER=false
EARTHSIGNAL_ASSISTANT_DB=/var/lib/earthsignal-web/assistant.sqlite3
